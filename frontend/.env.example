# NextPH Frontend Environment Configuration (Placeholders only - never commit real secrets)

# Public Site URL (Canonical public origin)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Headless WordPress REST API base endpoint
# (e.g. https://cms.nextph.example/wp-json or http://localhost:8080/wp-json in local dev)
WORDPRESS_API_URL=https://cms.nextph.example/wp-json

# Secret for validating unpublished story draft previews (server-side only)
WORDPRESS_PREVIEW_SECRET=replace_with_strong_preview_secret_in_hosting_manager

# Webhook revalidation secret for WordPress publish/update cache invalidation
REVALIDATION_SECRET=replace_with_strong_revalidation_secret_in_hosting_manager

# Newsletter provider adapter ('mock', 'buttondown', 'mailchimp', 'convertkit')
# In development, 'mock' allows testing without external accounts.
# In production, must be configured; unconfigured provider fails closed without false success.
NEWSLETTER_PROVIDER=mock
NEWSLETTER_API_KEY=placeholder_api_key_server_only
NEWSLETTER_LIST_ID=placeholder_list_id_server_only

# Advertising slots toggle (Must remain false until monetization is approved and active)
NEXT_PUBLIC_ADS_ENABLED=false
